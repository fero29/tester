# Produkčná konfigurácia. Lokálne .env.local vygeneruje služba prepare.
# Dve rôzne náhodné hodnoty (aspoň 32 znakov). Bez ADMIN_SECRET sú úpravy vypnuté.
SECRET_KEY=
ADMIN_SECRET=

# Verejný web používa HTTPS cez dôveryhodný Cloudflare Tunnel.
COOKIE_SECURE=true
# Zapnúť iba keď web nie je priamo prístupný mimo dôveryhodného proxy.
TRUST_PROXY_HEADERS=true
APP_UID=1000
APP_GID=1000

# Voliteľné; bežné testovanie funguje bez AI kľúča.
ANTHROPIC_API_KEY=

# Len pre explicitný --profile public; pozri DEPLOYMENT.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Voliteľná Cloudflare Web Analytics a dashboard integrácia.
CF_ANALYTICS_TOKEN=
CF_API_TOKEN=
CF_ACCOUNT_TAG=
CF_SITE_TAG=
